# Copy to .dev.vars for `npm run dev` (never commit .dev.vars).
GOOGLE_CLIENT_ID=265593746967-gle7m26ptk75neles0hm2krrhlkm56kj.apps.googleusercontent.com
SESSION_SECRET=a-local-secret-that-is-at-least-32-characters-long
