#   npx wrangler d1 execute double-sub --local --command "SELECT body FROM dev_outbox ORDER BY id DESC LIMIT 1"
MAIL_OUTBOX=1
TELEGRAM_BOT_NAME=YourTestBot
TELEGRAM_WEBHOOK_SECRET=local-webhook-secret
