{
  "name": "double-sub-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Accounts and sync for Double Sub: a Cloudflare Worker with a D1 database",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply double-sub --local",
    "migrate:remote": "wrangler d1 migrations apply double-sub --remote",
    "compile": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.5",
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.2"
  }
}
