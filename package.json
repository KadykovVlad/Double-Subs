{
  "name": "double-sub",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Dual subtitles for any HTML5 player",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:dictionary": "node scripts/build-dictionary.mjs",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "test:live": "wxt build && DS_EXTENSION_DIR=.output playwright test --config tests/live/playwright.live.config.ts",
    "test:e2e": "VITE_DS_E2E=1 wxt build && playwright test",
    "test:all": "npm run compile && npm run lint && npm test && npm run test:e2e && npm run check:store",
    "fixtures": "node tests/e2e/serve-fixtures.ts",
    "check:store": "wxt build && node scripts/check-store-build.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "preact": "^11.0.0"
  }
}
