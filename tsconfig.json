{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  // The server (Cloudflare Worker) has its own tsconfig and types; the rest is the .wxt default.
  "exclude": ["node_modules", ".output", "server"]
}
